def translate_super_call(name, replacement="super()"):
    """Translate super().__init__() to the native super call."""
    if name == "super().__init__" or name == "super().__init__()":
        return replacement
    if name.startswith("super()."):
        method = name[8:]
        return f"super.{method}"
    return name

